pipeline {
    agent any

    tools {
        maven 'Maven-3.9'
    }

    stages {

        stage('Build') {
            steps {
                echo 'Application is in Building Phase'
                bat 'mvn clean install'
            }
        }

        stage('Test') {
            steps {
                echo 'Application is in Testing Phase'
                bat 'mvn test'
            }
        }

        stage('Deployment') {
            steps {
                bat 'mvn clean deploy -DmuleDeploy -Pdev'
            }
        }
    }
}
