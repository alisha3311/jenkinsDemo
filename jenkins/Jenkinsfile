pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                echo 'Application is in Building Phase'
                bat 'mvn clean install'
            }
        }

        stage('Test') {
            steps {
                echo 'Application is in Testing Phase'
                bat 'mvn test'
            }
        }

        stage('Deployment') {
            steps {
                echo 'Application is in Deployment Phase'
                bat 'mvn clean package deploy -DmuleDeploy -Pdev'
            }
        }
    }
}
